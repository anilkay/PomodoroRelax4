@page
@model PomodoroRelax4.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users";
}

<div class="mb-4">
    <a href="/" class="text-fg/70 text-sm hover:text-fg">&larr; Back to app</a>
</div>

<div class="bg-surface border border-fg/5 backdrop-blur rounded-lg p-8 mb-6">
    <h2 class="text-2xl font-bold text-fg mb-6">Add User</h2>

    @if (Model.StatusMessage is not null)
    {
        <div class="bg-green-700/40 text-fg text-sm rounded p-3 mb-4">@Model.StatusMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="bg-red-700/40 text-fg text-sm rounded p-3 mb-4">@Model.ErrorMessage</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label class="block text-fg/80 text-sm mb-1">Username</label>
            <input asp-for="Input.UserName"
                   class="w-full px-3 py-2 rounded bg-field border border-fg/10 text-fg placeholder-fg/50 focus:outline-none focus:ring-2 focus:ring-fg/40"
                   placeholder="username" autocomplete="off" />
            <span asp-validation-for="Input.UserName" class="text-danger text-xs mt-1 block"></span>
        </div>

        <div class="mb-4">
            <label class="block text-fg/80 text-sm mb-1">Email</label>
            <input asp-for="Input.Email" type="email"
                   class="w-full px-3 py-2 rounded bg-field border border-fg/10 text-fg placeholder-fg/50 focus:outline-none focus:ring-2 focus:ring-fg/40"
                   placeholder="user@example.com" autocomplete="off" />
            <span asp-validation-for="Input.Email" class="text-danger text-xs mt-1 block"></span>
        </div>

        <div class="mb-6">
            <label class="block text-fg/80 text-sm mb-1">Password</label>
            <input asp-for="Input.Password" type="password"
                   class="w-full px-3 py-2 rounded bg-field border border-fg/10 text-fg placeholder-fg/50 focus:outline-none focus:ring-2 focus:ring-fg/40"
                   placeholder="At least @PasswordRules.MinLength characters" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="text-danger text-xs mt-1 block"></span>
        </div>

        <button type="submit"
                class="w-full bg-fg/20 hover:bg-fg/30 text-fg font-semibold py-2 rounded transition">
            Create User
        </button>
    </form>
</div>

<div class="bg-surface border border-fg/5 backdrop-blur rounded-lg p-8 mb-10">
    <h2 class="text-xl font-bold text-fg mb-4">Users (@Model.Users.Count)</h2>
    <ul class="divide-y divide-fg/10">
        @foreach (var user in Model.Users)
        {
            <li class="py-2">
                <div class="flex items-center justify-between gap-3">
                    <div class="min-w-0">
                        <div class="text-fg text-sm font-medium truncate">@user.UserName</div>
                        <div class="text-fg/60 text-xs truncate">@user.Email</div>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        @if (user.IsLockedOut)
                        {
                            <span class="text-xs text-fg bg-red-700/50 rounded px-2 py-0.5">Locked</span>
                        }
                        @if (user.IsAdmin)
                        {
                            <span class="text-xs text-fg bg-fg/20 rounded px-2 py-0.5">Admin</span>
                        }
                    </div>
                </div>
                @if (!user.IsAdmin)
                {
                    <details class="mt-2">
                        <summary class="text-fg/60 text-xs cursor-pointer hover:text-fg">Manage</summary>
                        <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:items-center">
                            <form method="post" asp-page-handler="ResetPassword" class="flex gap-2 flex-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <input type="password" name="newPassword" required minlength="@PasswordRules.MinLength"
                                       class="flex-1 min-w-0 px-3 py-1.5 rounded bg-field border border-fg/10 text-fg text-sm placeholder-fg/50 focus:outline-none focus:ring-2 focus:ring-fg/40"
                                       placeholder="New password" autocomplete="new-password" />
                                <button type="submit"
                                        class="bg-fg/20 hover:bg-fg/30 text-fg text-sm px-3 py-1.5 rounded transition shrink-0">
                                    Reset password
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Delete"
                                  data-confirm="Delete @user.UserName and all of their tasks, sessions and settings?">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit"
                                        class="bg-red-700/50 hover:bg-red-700/70 text-fg text-sm px-3 py-1.5 rounded transition">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </details>
                }
            </li>
        }
    </ul>
</div>
