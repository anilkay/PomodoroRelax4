# Cloudflare Tunnel token for the pomodoro-tunnel unit.
# Copy to tunnel.env (Quadlet: %E/pomodoro/tunnel.env) and restrict it:
#   chmod 600 tunnel.env
# Get the token from Cloudflare Zero Trust > Networks > Tunnels > your tunnel >
# "Install and run a connector" (the long string after --token). No quotes:
# Podman env files keep them literally. Never commit the real token.
TUNNEL_TOKEN=CHANGE_ME
