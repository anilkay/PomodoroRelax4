@page "/stats"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IStatsService StatsService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Stats — PomodoroRelax</PageTitle>

@if (error is not null)
{
    <div class="text-red-300 text-center mt-12 bg-white/10 rounded-lg p-4">⚠ @error</div>
}
else if (vm is null)
{
    <div class="text-white/60 text-center mt-12">Loading…</div>
}
else
{
    <!-- Summary Cards -->
    <div class="grid grid-cols-2 gap-3 mb-6">
        <div class="bg-white/10 rounded-lg p-4 text-center">
            <div class="text-4xl font-bold text-white">@vm.TodayPomodoros</div>
            <div class="text-white/60 text-sm mt-1">Today</div>
        </div>
        <div class="bg-white/10 rounded-lg p-4 text-center">
            <div class="text-4xl font-bold text-white">@vm.WeekPomodoros</div>
            <div class="text-white/60 text-sm mt-1">This Week</div>
        </div>
        <div class="bg-white/10 rounded-lg p-4 text-center">
            <div class="text-4xl font-bold text-white">@vm.TotalPomodoros</div>
            <div class="text-white/60 text-sm mt-1">All Time 🍅</div>
        </div>
        <div class="bg-white/10 rounded-lg p-4 text-center">
            <div class="text-4xl font-bold text-white">@FormatTime(vm.TotalFocusMinutes)</div>
            <div class="text-white/60 text-sm mt-1">Focus Time</div>
        </div>
    </div>

    <!-- Task Progress -->
    <div class="bg-white/10 rounded-lg p-4 mb-6">
        <div class="flex items-center justify-between mb-2">
            <span class="text-white font-semibold">Tasks Completed</span>
            <span class="text-white font-bold">@vm.TasksCompleted / @vm.TasksTotal</span>
        </div>
        @if (vm.TasksTotal > 0)
        {
            var pct = (int)((double)vm.TasksCompleted / vm.TasksTotal * 100);
            <div class="w-full bg-white/10 rounded-full h-2">
                <div class="bg-white/70 h-2 rounded-full transition-all duration-500"
                     style="width:@pct%"></div>
            </div>
        }
    </div>

    <!-- Last 7 Days -->
    <div class="bg-white/10 rounded-lg p-4 mb-6">
        <h3 class="text-white font-semibold mb-4">Last 7 Days</h3>
        @{
            var maxPomodoros = vm.Last7Days.Max(d => d.Pomodoros);
            if (maxPomodoros == 0) maxPomodoros = 1;
        }
        <div class="space-y-2">
            @foreach (var day in vm.Last7Days)
            {
                var barPct = (int)((double)day.Pomodoros / maxPomodoros * 100);
                var isToday = day == vm.Last7Days[^1];
                <div class="flex items-center gap-3">
                    <span class="text-white/60 text-xs w-8 shrink-0">@day.Date.ToString("ddd")</span>
                    <div class="flex-1 bg-white/10 rounded h-6 relative overflow-hidden">
                        <div class="h-full rounded transition-all duration-500 @(isToday ? "bg-white/60" : "bg-white/30")"
                             style="width:@(barPct)%"></div>
                    </div>
                    <span class="text-white text-xs w-6 text-right shrink-0">@day.Pomodoros</span>
                </div>
            }
        </div>
    </div>

    <!-- Recent Sessions -->
    @if (vm.RecentSessions.Any())
    {
        <div class="bg-white/10 rounded-lg p-4">
            <h3 class="text-white font-semibold mb-3">Recent Sessions</h3>
            <div class="space-y-2">
                @foreach (var s in vm.RecentSessions)
                {
                    <div class="flex items-center justify-between text-sm">
                        <div class="flex items-center gap-2">
                            <span class="@BadgeClass(s.SessionType) text-white text-xs px-2 py-0.5 rounded-full">
                                @ModeLabel(s.SessionType)
                            </span>
                            @if (s.TaskTitle is not null)
                            {
                                <span class="text-white/70 truncate max-w-[160px]">@s.TaskTitle</span>
                            }
                        </div>
                        <div class="text-white/50 text-xs whitespace-nowrap">
                            @s.DurationMinutes min · @s.CompletedAt.ToString("MMM d HH:mm")
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="text-center mt-6">
        <a href="/" class="text-white/60 hover:text-white text-sm transition">← Back to Timer</a>
    </div>
}

@code {
    private StatsViewModel? vm;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || vm is not null || error is not null) return;

        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (userId is not null)
            {
                var offsetMinutes = await JS.InvokeAsync<int>("pomodoroTime.utcOffsetMinutes");
                vm = await StatsService.GetStatsAsync(userId, TimeSpan.FromMinutes(offsetMinutes));
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

        StateHasChanged();
    }

    private static string FormatTime(int totalMinutes)
    {
        if (totalMinutes < 60) return $"{totalMinutes}m";
        var h = totalMinutes / 60;
        var m = totalMinutes % 60;
        return m == 0 ? $"{h}h" : $"{h}h {m}m";
    }

    private static string ModeLabel(TimerMode mode) => mode switch
    {
        TimerMode.ShortBreak => "Short",
        TimerMode.LongBreak => "Long",
        _ => "Focus"
    };

    private static string BadgeClass(TimerMode mode) => mode switch
    {
        TimerMode.ShortBreak => "bg-shortbreak",
        TimerMode.LongBreak => "bg-longbreak",
        _ => "bg-pomodoro"
    };
}
