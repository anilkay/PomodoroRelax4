@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject ITaskService TaskService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>PomodoroRelax</PageTitle>
<SignOutGuard />

<CascadingValue Value="currentMode">
    <TimerDisplay ActiveTaskId="activeTaskId"
                  activeTaskTitle="@activeTaskTitle"
                  OnModeChanged="HandleModeChanged"
                  OnPomodoroCompleted="HandlePomodoroCompleted" />

    <TaskList @ref="taskListRef"
              SelectedTaskId="activeTaskId"
              OnTaskSelected="HandleTaskSelected" />
</CascadingValue>

@code {
    private TimerMode currentMode = TimerMode.Pomodoro;
    private int? activeTaskId;
    private string? activeTaskTitle;
    private TaskList? taskListRef;

    // /?task=12, from ▶ on the To Do page, opens the timer with that task selected
    [SupplyParameterFromQuery(Name = "task")]
    public int? TaskFromQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (TaskFromQuery is not int id) return;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null) return;

        // Only the user's own, open tasks
        var task = (await TaskService.GetTasksAsync(userId)).FirstOrDefault(t => t.Id == id && !t.IsCompleted);
        if (task is not null)
        {
            activeTaskId = task.Id;
            activeTaskTitle = task.Title;
        }
    }

    private void HandleModeChanged(TimerMode mode)
    {
        currentMode = mode;
        StateHasChanged();
    }

    private void HandleTaskSelected((int? Id, string? Title) selection)
    {
        activeTaskId = selection.Id;
        activeTaskTitle = selection.Title;
        StateHasChanged();
    }

    private async Task HandlePomodoroCompleted()
    {
        if (taskListRef is not null)
            await taskListRef.RefreshTasks();
    }
}
