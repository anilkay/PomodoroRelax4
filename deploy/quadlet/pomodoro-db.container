[Unit]
Description=PomodoroRelax4 PostgreSQL

[Container]
ContainerName=pomodoro-db
Image=docker.io/library/postgres:18.6
Network=pomodoro.network
Volume=pomodoro-db.volume:/var/lib/postgresql
EnvironmentFile=%E/pomodoro/pomodoro.env
# TCP on purpose: during first-time init the image runs a temporary server on
# the Unix socket only, which must not count as ready.
HealthCmd=pg_isready -h 127.0.0.1 -p 5432
HealthInterval=10s
HealthStartPeriod=30s
HealthRetries=5
# Report "started" to systemd only once the health check passes, so the app
# does not run its startup migrations against a database that is still starting.
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
