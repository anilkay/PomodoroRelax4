# Copy to pomodoro.env (Quadlet: %E/pomodoro/pomodoro.env) and restrict it:
#   chmod 600 pomodoro.env
# Use the same database password in both places it appears.

# PostgreSQL (default). The POSTGRES_* values are read only when the data volume
# is first initialised.
Database__Provider=PostgreSql
POSTGRES_USER=pomodoro
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pomodoro
# "pomodoro-db" is the database container's name on the shared network. The app
# applies migrations on startup.
ConnectionStrings__DefaultConnection=Host=pomodoro-db;Port=5432;Database=pomodoro;Username=pomodoro;Password=CHANGE_ME

# SQL Server instead (deploy/quadlet/sqlserver, deploy/compose.sqlserver.yaml):
# replace the block above with this one. The SA password must be at least 8
# characters and use three of: upper case, lower case, digits, symbols. Avoid ";"
# since it ends a connection string value. Express is free for production use
# (10 GB per database); Developer is not licensed for production.
#Database__Provider=SqlServer
#ACCEPT_EULA=Y
#MSSQL_SA_PASSWORD=CHANGE_ME
#MSSQL_PID=Express
#ConnectionStrings__DefaultConnection=Server=pomodoro-db,1433;Database=PomodoroRelax4;User Id=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# Administrator. Public sign-up is closed: /Account/Register accepts only this
# e-mail, and only until it has an account. Register it right after the first
# start, then add everyone else on /Admin/Users. Changing it moves the Admin role
# to the new address on the next restart; leaving it empty leaves no admin.
Admin__Email=you@example.com

# The app listens on plain HTTP behind a TLS-terminating proxy (Cloudflare
# Tunnel, Caddy, nginx, ...). This makes it honour X-Forwarded-Proto/For, so it
# knows the request was HTTPS and the sign-in/register rate limits see the real
# client IP. Keep it on (without it the HTTPS redirect loops), and keep the
# published port bound to 127.0.0.1.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Log level (Trace, Debug, Information, Warning, Error).
#Logging__LogLevel__Default=Information
