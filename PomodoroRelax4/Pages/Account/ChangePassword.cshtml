@page
@model PomodoroRelax4.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="flex justify-center">
    <div class="bg-white/10 backdrop-blur rounded-lg p-8 w-full max-w-sm">
        <h2 class="text-2xl font-bold text-white text-center mb-6">Change Password</h2>

        @if (Model.StatusMessage is not null)
        {
            <div class="bg-green-700/40 text-white text-sm rounded p-3 mb-4">@Model.StatusMessage</div>
        }
        @if (Model.ErrorMessage is not null)
        {
            <div class="bg-red-700/40 text-white text-sm rounded p-3 mb-4">@Model.ErrorMessage</div>
        }

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="block text-white/80 text-sm mb-1">Current password</label>
                <input asp-for="Input.CurrentPassword" type="password"
                       class="w-full px-3 py-2 rounded bg-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white/40"
                       autocomplete="current-password" />
                <span asp-validation-for="Input.CurrentPassword" class="text-red-300 text-xs mt-1 block"></span>
            </div>

            <div class="mb-4">
                <label class="block text-white/80 text-sm mb-1">New password</label>
                <input asp-for="Input.NewPassword" type="password"
                       class="w-full px-3 py-2 rounded bg-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white/40"
                       placeholder="At least 6 characters" autocomplete="new-password" />
                <span asp-validation-for="Input.NewPassword" class="text-red-300 text-xs mt-1 block"></span>
            </div>

            <div class="mb-6">
                <label class="block text-white/80 text-sm mb-1">Confirm new password</label>
                <input asp-for="Input.ConfirmPassword" type="password"
                       class="w-full px-3 py-2 rounded bg-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white/40"
                       autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-300 text-xs mt-1 block"></span>
            </div>

            <button type="submit"
                    class="w-full bg-white/20 hover:bg-white/30 text-white font-semibold py-2 rounded transition">
                Change Password
            </button>
        </form>

        <p class="text-white/60 text-sm text-center mt-4">
            <a href="/settings" class="hover:text-white">&larr; Back to settings</a>
        </p>
    </div>
</div>
