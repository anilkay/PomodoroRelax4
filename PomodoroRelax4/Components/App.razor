@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IFileVersionProvider FileVersions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PomodoroRelax</title>
    <base href="/" />
    <script src="@V("/js/theme.js")"></script>
    @* Fetched at once instead of after the CSS is parsed; the timer digits use JetBrains Mono *@
    <link rel="preload" href="/fonts/inter-v20-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-v24-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@V("/css/tailwind.css")" />
    <link rel="stylesheet" href="@V("/css/app.css")" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.server.js"></script>
    <script src="@V("/js/sound.js")"></script>
    <script src="@V("/js/site.js")"></script>
</body>
</html>

@code {
    // Adds ?v=<content hash>, like asp-append-version in the Razor Pages layout, so a deploy
    // that changes a file changes its URL and browsers can't keep using a cached old copy
    private string V(string path) => FileVersions.AddFileVersionToPath(PathString.Empty, path);
}
