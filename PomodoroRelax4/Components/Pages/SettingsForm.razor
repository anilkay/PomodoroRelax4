@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject ISettingsService SettingsService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@implements IDisposable

<div class="flex justify-center mt-6">
    <div class="bg-surface border border-fg/5 rounded-lg p-6 w-full max-w-md">
        <h2 class="text-xl font-bold text-fg mb-6">⚙ Timer Settings</h2>

        @if (Values is null)
        {
            <div class="text-fg/50 text-center py-8">Loading…</div>
        }
        else
        {
            @if (saved)
            {
                <div class="bg-green-500/30 text-fg text-sm rounded p-3 mb-4 flex items-center gap-2">
                    <span>✓</span> Settings saved!
                </div>
            }

            <div class="space-y-5">
                <div>
                    <label class="block text-fg/80 text-sm mb-1 font-medium">🍅 Pomodoro</label>
                    <div class="flex items-center gap-3">
                        <button class="w-8 h-8 bg-fg/10 hover:bg-fg/20 text-fg rounded-md transition font-bold"
                                @onclick="() => Values.PomodoroDurationMinutes = Math.Max(1, Values.PomodoroDurationMinutes - 1)">−</button>
                        <input type="number" min="1" max="120"
                               @bind="Values.PomodoroDurationMinutes"
                               class="w-20 text-center px-2 py-2 rounded bg-field border border-fg/10 text-fg font-bold text-lg focus:outline-none focus:ring-2 focus:ring-fg/40" />
                        <button class="w-8 h-8 bg-fg/10 hover:bg-fg/20 text-fg rounded-md transition font-bold"
                                @onclick="() => Values.PomodoroDurationMinutes = Math.Min(120, Values.PomodoroDurationMinutes + 1)">+</button>
                        <span class="text-fg/50 text-sm">min</span>
                    </div>
                </div>

                <div>
                    <label class="block text-fg/80 text-sm mb-1 font-medium">☕ Short Break</label>
                    <div class="flex items-center gap-3">
                        <button class="w-8 h-8 bg-fg/10 hover:bg-fg/20 text-fg rounded-md transition font-bold"
                                @onclick="() => Values.ShortBreakDurationMinutes = Math.Max(1, Values.ShortBreakDurationMinutes - 1)">−</button>
                        <input type="number" min="1" max="60"
                               @bind="Values.ShortBreakDurationMinutes"
                               class="w-20 text-center px-2 py-2 rounded bg-field border border-fg/10 text-fg font-bold text-lg focus:outline-none focus:ring-2 focus:ring-fg/40" />
                        <button class="w-8 h-8 bg-fg/10 hover:bg-fg/20 text-fg rounded-md transition font-bold"
                                @onclick="() => Values.ShortBreakDurationMinutes = Math.Min(60, Values.ShortBreakDurationMinutes + 1)">+</button>
                        <span class="text-fg/50 text-sm">min</span>
                    </div>
                </div>

                <div>
                    <label class="block text-fg/80 text-sm mb-1 font-medium">🛌 Long Break</label>
                    <div class="flex items-center gap-3">
                        <button class="w-8 h-8 bg-fg/10 hover:bg-fg/20 text-fg rounded-md transition font-bold"
                                @onclick="() => Values.LongBreakDurationMinutes = Math.Max(1, Values.LongBreakDurationMinutes - 1)">−</button>
                        <input type="number" min="1" max="120"
                               @bind="Values.LongBreakDurationMinutes"
                               class="w-20 text-center px-2 py-2 rounded bg-field border border-fg/10 text-fg font-bold text-lg focus:outline-none focus:ring-2 focus:ring-fg/40" />
                        <button class="w-8 h-8 bg-fg/10 hover:bg-fg/20 text-fg rounded-md transition font-bold"
                                @onclick="() => Values.LongBreakDurationMinutes = Math.Min(120, Values.LongBreakDurationMinutes + 1)">+</button>
                        <span class="text-fg/50 text-sm">min</span>
                    </div>
                </div>
            </div>

            <div class="mt-2 pt-4 border-t border-fg/10">
                <p class="text-fg/40 text-xs">Changes apply to the timer when you next start a session.</p>
            </div>

            <div class="flex justify-end items-center gap-3 mt-4">
                <a href="/Account/ChangePassword"
                   class="mr-auto text-fg/60 hover:text-fg text-sm transition">Change password</a>
                <a href="/"
                   class="px-4 py-2 text-fg/60 hover:text-fg text-sm transition">← Back</a>
                <button class="px-6 py-2 bg-fg/20 hover:bg-fg/30 text-fg font-semibold rounded transition disabled:opacity-50"
                        disabled="@saving"
                        @onclick="Save">
                    @(saving ? "Saving…" : "Save")
                </button>
            </div>

            <div class="mt-6 pt-4 border-t border-fg/10">
                <h3 class="text-fg font-semibold text-sm mb-1">Export your data</h3>
                <p class="text-fg/40 text-xs mb-3">Tasks, sessions and settings. Times are in UTC.</p>
                <div class="flex flex-wrap gap-3">
                    <a href="/export/xlsx" download
                       class="px-4 py-2 bg-fg/10 hover:bg-fg/20 text-fg text-sm rounded transition">Excel (.xlsx)</a>
                    <a href="/export/json" download
                       class="px-4 py-2 bg-fg/10 hover:bg-fg/20 text-fg text-sm rounded transition">JSON</a>
                    <a href="/Data/Import"
                       class="px-4 py-2 text-fg/60 hover:text-fg text-sm transition">Import a file…</a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool saved;
    private bool saving;
    private readonly CancellationTokenSource _cts = new();

    // Loaded while prerendering and carried into the circuit, so the form is there in the first HTML
    [PersistentState]
    public UserSettings? Values { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Values is not null) return;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is not null)
            Values = await SettingsService.GetSettingsAsync(userId);
    }

    private async Task Save()
    {
        if (Values is null || saving) return;
        saving = true;

        Values.PomodoroDurationMinutes    = Math.Clamp(Values.PomodoroDurationMinutes,    1, 120);
        Values.ShortBreakDurationMinutes  = Math.Clamp(Values.ShortBreakDurationMinutes,   1,  60);
        Values.LongBreakDurationMinutes   = Math.Clamp(Values.LongBreakDurationMinutes,    1, 120);

        await SettingsService.SaveSettingsAsync(Values);

        saving = false;
        saved = true;
        StateHasChanged();

        // Auto-dismiss after 2.5 s (cancel silently if user navigates away)
        try
        {
            await Task.Delay(2500, _cts.Token);
            saved = false;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose() => _cts.Cancel();
}
