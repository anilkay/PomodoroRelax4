@page
@model PomodoroRelax4.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="flex justify-center">
    <div class="bg-surface border border-fg/5 backdrop-blur rounded-lg p-8 w-full max-w-sm">
        <h2 class="text-2xl font-bold text-fg text-center mb-6">Login</h2>

        <partial name="_StatusMessages" model="((string?)null, Model.ErrorMessage)" />

        <form method="post">
            @Html.AntiForgeryToken()

            <form-field asp-for="Input.EmailOrUserName" label="Username or Email" placeholder="username or you@example.com" />

            <form-field asp-for="Input.Password" type="password" label="Password" placeholder="••••••" wrapper-class="mb-6" />

            <input type="hidden" asp-for="ReturnUrl" />

            <button type="submit"
                    class="w-full bg-fg/20 hover:bg-fg/30 text-fg font-semibold py-2 rounded transition">
                Login
            </button>
        </form>

        <p class="text-fg/60 text-sm text-center mt-4">
            Don't have an account? Ask the administrator.
        </p>
    </div>
</div>
