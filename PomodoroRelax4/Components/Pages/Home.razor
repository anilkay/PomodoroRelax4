@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject ITaskService TaskService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>PomodoroRelax</PageTitle>
<SignOutGuard />

<CascadingValue Value="currentMode">
    <TimerDisplay ActiveTaskId="activeTaskId"
                  activeTaskTitle="@activeTaskTitle"
                  OnModeChanged="HandleModeChanged"
                  OnPomodoroCompleted="HandlePomodoroCompleted" />

    @if (askDone is not null)
    {
        <div class="glass rounded-xl px-4 py-3 mt-6 flex flex-wrap items-center gap-x-4 gap-y-2" role="status">
            <div class="flex-1 min-w-[12rem] text-sm text-fg/80">
                <span class="font-semibold text-fg">@askDone.Title</span>
                <span class="block text-xs text-fg/50 mt-0.5">
                    @askDone.CompletedPomodoros of @askDone.EstimatedPomodoros @(askDone.EstimatedPomodoros == 1 ? "pomodoro" : "pomodoros") done. Is it finished?
                </span>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" class="px-3 py-1.5 text-xs rounded-lg text-fg/60 transition hover:bg-fg/5" @onclick="OneMoreAsync">Not yet, +1</button>
                <button type="button" class="px-4 py-1.5 text-xs rounded-lg font-semibold bg-pomodoro text-app-base transition hover:opacity-90" @onclick="FinishAsync">Done ✓</button>
            </div>
        </div>
    }

    <TaskList @ref="taskListRef"
              SelectedTaskId="activeTaskId"
              OnTaskSelected="HandleTaskSelected" />
</CascadingValue>

@code {
    private TimerMode currentMode = TimerMode.Pomodoro;
    private int? activeTaskId;
    private string? activeTaskTitle;
    private TaskList? taskListRef;

    // /?task=12, from ▶ on the To Do page, opens the timer with that task selected
    [SupplyParameterFromQuery(Name = "task")]
    public int? TaskFromQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (TaskFromQuery is not int id) return;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null) return;

        // Only the user's own, open tasks
        var task = (await TaskService.GetTasksAsync(userId)).FirstOrDefault(t => t.Id == id && !t.IsCompleted);
        if (task is not null)
        {
            activeTaskId = task.Id;
            activeTaskTitle = task.Title;
        }
    }

    private void HandleModeChanged(TimerMode mode)
    {
        currentMode = mode;
    }

    private void HandleTaskSelected((int? Id, string? Title) selection)
    {
        activeTaskId = selection.Id;
        activeTaskTitle = selection.Title;
        if (askDone is not null && askDone.Id != selection.Id) askDone = null;
    }

    // The task whose estimate the last pomodoro reached: asks whether it is finished
    private PomodoroTask? askDone;

    private async Task HandlePomodoroCompleted(PomodoroTask? task)
    {
        if (taskListRef is not null)
            await taskListRef.RefreshTasks();

        if (task is { IsCompleted: false } && task.CompletedPomodoros >= task.EstimatedPomodoros)
            askDone = task;
    }

    private async Task FinishAsync()
    {
        if (askDone is not { } task) return;
        askDone = null;
        task.IsCompleted = true;
        await TaskService.UpdateTaskAsync(task);

        if (taskListRef is null) return;
        await taskListRef.RefreshTasks();
        // On to the next task, so the next Start works on it
        if (activeTaskId == task.Id)
        {
            var next = taskListRef.NextTask(task.Id);
            activeTaskId = next?.Id;
            activeTaskTitle = next?.Title;
        }
    }

    private async Task OneMoreAsync()
    {
        if (askDone is not { } task) return;
        askDone = null;
        task.EstimatedPomodoros = Math.Min(99, task.CompletedPomodoros + 1);
        await TaskService.UpdateTaskAsync(task);
        if (taskListRef is not null)
            await taskListRef.RefreshTasks();
    }
}
