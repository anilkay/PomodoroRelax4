@page "/stats"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IStatsService StatsService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Stats — PomodoroRelax</PageTitle>
<SignOutGuard />

@if (error is not null)
{
    <div class="text-danger text-center mt-12 bg-surface border border-fg/5 rounded-lg p-4">⚠ @error</div>
}
else if (Model is null)
{
    <div class="text-fg/60 text-center mt-12">Loading…</div>
}
else
{
    <!-- Summary Cards -->
    <div class="grid grid-cols-2 gap-3 mb-6">
        <div class="bg-surface border border-fg/5 rounded-lg p-4 text-center">
            <div class="text-4xl font-bold text-fg">@Model.TodayPomodoros</div>
            <div class="text-fg/60 text-sm mt-1">Today</div>
        </div>
        <div class="bg-surface border border-fg/5 rounded-lg p-4 text-center">
            <div class="text-4xl font-bold text-fg">@Model.WeekPomodoros</div>
            <div class="text-fg/60 text-sm mt-1">This Week</div>
        </div>
        <div class="bg-surface border border-fg/5 rounded-lg p-4 text-center">
            <div class="text-4xl font-bold text-fg">@Model.TotalPomodoros</div>
            <div class="text-fg/60 text-sm mt-1">All Time 🍅</div>
        </div>
        <div class="bg-surface border border-fg/5 rounded-lg p-4 text-center">
            <div class="text-4xl font-bold text-fg">@FormatTime(Model.TotalFocusMinutes)</div>
            <div class="text-fg/60 text-sm mt-1">Focus Time</div>
        </div>
    </div>

    <!-- Task Progress -->
    <div class="bg-surface border border-fg/5 rounded-lg p-4 mb-6">
        <div class="flex items-center justify-between mb-2">
            <span class="text-fg font-semibold">Tasks Completed</span>
            <span class="text-fg font-bold">@Model.TasksCompleted / @Model.TasksTotal</span>
        </div>
        @if (Model.TasksTotal > 0)
        {
            var pct = (int)((double)Model.TasksCompleted / Model.TasksTotal * 100);
            <div class="w-full bg-fg/10 rounded-full h-2">
                <div class="bg-fg/70 h-2 rounded-full transition-all duration-500"
                     style="width:@pct%"></div>
            </div>
        }
    </div>

    <!-- Last 7 Days -->
    <div class="bg-surface border border-fg/5 rounded-lg p-4 mb-6">
        <h3 class="text-fg font-semibold mb-4">Last 7 Days</h3>
        @{
            var maxPomodoros = Model.Last7Days.Max(d => d.Pomodoros);
            if (maxPomodoros == 0) maxPomodoros = 1;
        }
        <div class="space-y-2">
            @foreach (var day in Model.Last7Days)
            {
                var barPct = (int)((double)day.Pomodoros / maxPomodoros * 100);
                var isToday = day == Model.Last7Days[^1];
                <div class="flex items-center gap-3">
                    <span class="text-fg/60 text-xs w-8 shrink-0">@day.Date.ToString("ddd")</span>
                    <div class="flex-1 bg-fg/10 rounded h-6 relative overflow-hidden">
                        <div class="h-full rounded transition-all duration-500 @(isToday ? "bg-fg/60" : "bg-fg/30")"
                             style="width:@(barPct)%"></div>
                    </div>
                    <span class="text-fg text-xs w-6 text-right shrink-0">@day.Pomodoros</span>
                </div>
            }
        </div>
    </div>

    <!-- Recent Sessions -->
    @if (Model.RecentSessions.Any())
    {
        <div class="bg-surface border border-fg/5 rounded-lg p-4">
            <h3 class="text-fg font-semibold mb-3">Recent Sessions</h3>
            <div class="space-y-2">
                @foreach (var s in Model.RecentSessions)
                {
                    <div class="flex items-center justify-between text-sm">
                        <div class="flex items-center gap-2">
                            <span class="@BadgeClass(s.SessionType) text-app-base font-semibold text-xs px-2 py-0.5 rounded-full">
                                @ModeLabel(s.SessionType)
                            </span>
                            @if (s.TaskTitle is not null)
                            {
                                <span class="text-fg/70 truncate max-w-[160px]">@s.TaskTitle</span>
                            }
                        </div>
                        <div class="text-fg/50 text-xs whitespace-nowrap">
                            @s.DurationMinutes min · @s.CompletedAt.ToString("MMM d HH:mm")
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="text-center mt-6">
        <a href="/" class="text-fg/60 hover:text-fg text-sm transition">← Back to Timer</a>
    </div>
}

@code {
    private string? error;

    // Only set while prerendering (statically, before the circuit exists)
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Computed while prerendering when the tz cookie gives the viewer's day, and carried into the
    // circuit; otherwise (first visit) computed once the browser can be asked
    [PersistentState]
    public StatsViewModel? Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Model is null && ClientPreferences.UtcOffsetMinutes(HttpContext) is int offset)
            await LoadAsync(offset);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Model is not null || error is not null) return;

        try
        {
            await LoadAsync(await JS.InvokeAsync<int>("pomodoroTime.utcOffsetMinutes"));
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        StateHasChanged();
    }

    private async Task LoadAsync(int offsetMinutes)
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (userId is not null)
                Model = await StatsService.GetStatsAsync(userId, TimeSpan.FromMinutes(offsetMinutes));
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private static string FormatTime(int totalMinutes)
    {
        if (totalMinutes < 60) return $"{totalMinutes}m";
        var h = totalMinutes / 60;
        var m = totalMinutes % 60;
        return m == 0 ? $"{h}h" : $"{h}h {m}m";
    }

    private static string ModeLabel(TimerMode mode) => mode switch
    {
        TimerMode.ShortBreak => "Short",
        TimerMode.LongBreak => "Long",
        _ => "Focus"
    };

    private static string BadgeClass(TimerMode mode) => mode switch
    {
        TimerMode.ShortBreak => "bg-shortbreak",
        TimerMode.LongBreak => "bg-longbreak",
        _ => "bg-pomodoro"
    };
}
