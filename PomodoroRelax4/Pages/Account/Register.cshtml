@page
@model PomodoroRelax4.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="flex justify-center">
    <div class="bg-surface border border-fg/5 backdrop-blur rounded-lg p-8 w-full max-w-sm">
        <h2 class="text-2xl font-bold text-fg text-center mb-6">@(Model.RegistrationOpen ? "Create Admin Account" : "Registration Closed")</h2>

        <partial name="_StatusMessages" model="((string?)null, Model.ErrorMessage)" />

        @if (!Model.RegistrationOpen)
        {
            <p class="text-fg/80 text-sm text-center">Accounts are created by the administrator. Ask them for one.</p>
        }
        else
        {
        <p class="text-fg/70 text-sm mb-4">Use the administrator e-mail set in the server configuration.</p>

        <form method="post">
            @Html.AntiForgeryToken()

            <form-field asp-for="Input.UserName" label="Username" placeholder="myusername" autocomplete="username" />

            <form-field asp-for="Input.Email" type="email" label="Email" placeholder="you@example.com" />

            <form-field asp-for="Input.Password" type="password" label="Password" placeholder="At least @PasswordRules.MinLength characters" autocomplete="new-password" />

            <form-field asp-for="Input.ConfirmPassword" type="password" label="Confirm Password" placeholder="Repeat password" autocomplete="new-password" wrapper-class="mb-6" />

            <button type="submit"
                    class="w-full bg-fg/20 hover:bg-fg/30 text-fg font-semibold py-2 rounded transition">
                Register
            </button>
        </form>
        }

        <p class="text-fg/60 text-sm text-center mt-4">
            Already have an account? <a href="/Account/Login" class="text-fg underline">Login</a>
        </p>
    </div>
</div>
