@page
@model PomodoroRelax4.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="flex justify-center">
    <div class="bg-surface border border-fg/5 backdrop-blur rounded-lg p-8 w-full max-w-sm">
        <h2 class="text-2xl font-bold text-fg text-center mb-6">Change Password</h2>

        <partial name="_StatusMessages" model="(Model.StatusMessage, Model.ErrorMessage)" />

        <form method="post">
            @Html.AntiForgeryToken()

            <form-field asp-for="Input.CurrentPassword" type="password" label="Current password" autocomplete="current-password" />

            <form-field asp-for="Input.NewPassword" type="password" label="New password" placeholder="At least @PasswordRules.MinLength characters" autocomplete="new-password" />

            <form-field asp-for="Input.ConfirmPassword" type="password" label="Confirm new password" autocomplete="new-password" wrapper-class="mb-6" />

            <button type="submit"
                    class="w-full bg-fg/20 hover:bg-fg/30 text-fg font-semibold py-2 rounded transition">
                Change Password
            </button>
        </form>

        <p class="text-fg/60 text-sm text-center mt-4">
            <a href="/settings" class="hover:text-fg">&larr; Back to settings</a>
        </p>
    </div>
</div>
