@page
@model PomodoroRelax4.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="flex justify-center">
    <div class="bg-surface border border-fg/5 backdrop-blur rounded-lg p-8 w-full max-w-sm">
        <h2 class="text-2xl font-bold text-fg text-center mb-6">Login</h2>

        @if (Model.ErrorMessage is not null)
        {
            <div class="bg-red-700/40 text-fg text-sm rounded p-3 mb-4">@Model.ErrorMessage</div>
        }

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="block text-fg/80 text-sm mb-1">Username or Email</label>
                <input asp-for="Input.EmailOrUserName"
                       class="w-full px-3 py-2 rounded bg-field border border-fg/10 text-fg placeholder-fg/50 focus:outline-none focus:ring-2 focus:ring-fg/40"
                       placeholder="username or you@example.com" />
                <span asp-validation-for="Input.EmailOrUserName" class="text-danger text-xs mt-1 block"></span>
            </div>

            <div class="mb-6">
                <label class="block text-fg/80 text-sm mb-1">Password</label>
                <input asp-for="Input.Password" type="password"
                       class="w-full px-3 py-2 rounded bg-field border border-fg/10 text-fg placeholder-fg/50 focus:outline-none focus:ring-2 focus:ring-fg/40"
                       placeholder="••••••" />
                <span asp-validation-for="Input.Password" class="text-danger text-xs mt-1 block"></span>
            </div>

            <input type="hidden" asp-for="ReturnUrl" />

            <button type="submit"
                    class="w-full bg-fg/20 hover:bg-fg/30 text-fg font-semibold py-2 rounded transition">
                Login
            </button>
        </form>

        <p class="text-fg/60 text-sm text-center mt-4">
            Don't have an account? Ask the administrator.
        </p>
    </div>
</div>
