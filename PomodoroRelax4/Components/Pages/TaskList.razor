@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject ITaskService TaskService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="mt-8">

    <!-- Section label: the To Do page's lists, to pick what to work on -->
    <div class="flex items-center gap-3 mb-4">
        <div class="h-px flex-1" style="background:rgb(var(--fg) / 0.07)"></div>
        <div class="flex items-center gap-1" role="group" aria-label="Show">
            @foreach (var f in Enum.GetValues<ListFilter>())
            {
                var on = f == filter;
                var openCount = tasks.Count(t => !t.IsCompleted && InFilter(t, f));
                <button type="button"
                        class="px-2 py-1 rounded-md text-xs font-semibold uppercase tracking-widest transition hover:bg-fg/5 @(on ? "text-fg/70" : "text-fg/25 hover:text-fg/50")"
                        aria-pressed="@(on ? "true" : "false")"
                        @onclick="() => SetFilter(f)">
                    @(f == ListFilter.All ? "Tasks" : f.ToString())
                    @if (f != ListFilter.All && openCount > 0)
                    {
                        <span class="ml-0.5 font-normal tracking-normal">@openCount</span>
                    }
                </button>
            }
        </div>
        <div class="h-px flex-1" style="background:rgb(var(--fg) / 0.07)"></div>
    </div>

    @if (filter != ListFilter.All && !VisibleTasks.Any())
    {
        <p class="text-center text-xs mb-3" style="color:rgb(var(--fg) / 0.35)">
            @(filter == ListFilter.Today ? "Nothing due today." : "No important tasks. Add one with High priority.")
        </p>
    }

    <!-- Task Items -->
    <div class="space-y-2 mb-3">
        @foreach (var task in VisibleTasks)
        {
            var isSelected = task.Id == SelectedTaskId;
            var due = DueLabel(task);
            <div class="glass rounded-xl transition-all duration-150"
                 style="@(isSelected ? "border-left: 3px solid var(--accent, #f87171);" : "border-left: 3px solid transparent;")">

                <div class="px-4 py-3 flex items-center gap-3 cursor-pointer rounded-xl transition hover:bg-fg/[0.03]"
                     style="@(isSelected ? "padding-left: 13px;" : "")"
                     @onclick="() => SelectTask(task)">

                    <!-- Complete checkbox -->
                    <button class="flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center transition-all duration-150"
                            style="@(task.IsCompleted ? "background:rgb(var(--fg) / 0.2);border:1.5px solid rgb(var(--fg) / 0.4)" : "border:1.5px solid rgb(var(--fg) / 0.25)")"
                            title="@(task.IsCompleted ? "Mark as not done" : "Mark as done")"
                            @onclick:stopPropagation="true"
                            @onclick="() => ToggleComplete(task)">
                        @if (task.IsCompleted)
                        {
                            <span style="color:rgb(var(--fg) / 0.8);font-size:0.6rem;line-height:1">✓</span>
                        }
                    </button>

                    <!-- Task info -->
                    <div class="flex-1 min-w-0">
                        <span class="block truncate text-sm @(task.IsCompleted ? "line-through" : "")"
                              style="color:@(task.IsCompleted ? "rgb(var(--fg) / 0.35)" : "rgb(var(--fg) / 0.85)")">
                            @if (task.Priority == TaskPriority.High && !task.IsCompleted)
                            {
                                <span class="text-danger font-bold mr-1" title="High priority">!</span>
                            }
                            @task.Title
                        </span>

                        @if (due is not null || task.Priority == TaskPriority.Low || task.Notes is not null)
                        {
                            <div class="flex items-center gap-2 mt-0.5 text-[11px] min-w-0" style="color:rgb(var(--fg) / 0.4)">
                                @if (due is not null)
                                {
                                    <span class="flex-shrink-0 @(due.Value.Overdue ? "text-danger font-medium" : "")">@due.Value.Text</span>
                                }
                                @if (task.Priority == TaskPriority.Low)
                                {
                                    <span class="flex-shrink-0">Low priority</span>
                                }
                                @if (task.Notes is not null)
                                {
                                    <span class="truncate" title="@task.Notes">✎ @task.Notes</span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Pomodoro count pill -->
                    <span class="text-xs px-2 py-0.5 rounded-full flex-shrink-0"
                          style="background:rgb(var(--fg) / 0.06);color:rgb(var(--fg) / 0.4)"
                          title="Pomodoros done / estimated">
                        @task.CompletedPomodoros / @task.EstimatedPomodoros
                    </span>

                    <!-- Actions -->
                    <div class="flex items-center gap-0.5 flex-shrink-0">
                        <button class="w-7 h-7 rounded-lg flex items-center justify-center transition hover:bg-fg/10 text-xs"
                                style="color:rgb(var(--fg) / 0.3)"
                                @onclick:stopPropagation="true"
                                @onclick="() => Move(task, -1)" title="Move up">▴</button>
                        <button class="w-7 h-7 rounded-lg flex items-center justify-center transition hover:bg-fg/10 text-xs"
                                style="color:rgb(var(--fg) / 0.3)"
                                @onclick:stopPropagation="true"
                                @onclick="() => Move(task, 1)" title="Move down">▾</button>
                        <button class="w-7 h-7 rounded-lg flex items-center justify-center transition hover:bg-fg/10 text-xs"
                                style="color:rgb(var(--fg) / 0.3)"
                                @onclick:stopPropagation="true"
                                @onclick="() => StartEdit(task)" title="Edit">✎</button>
                        <button class="w-7 h-7 rounded-lg flex items-center justify-center transition hover:bg-red-500/20 text-xs"
                                style="color:rgb(var(--fg) / 0.3)"
                                @onclick:stopPropagation="true"
                                @onclick="() => DeleteTask(task)" title="Delete">✕</button>
                    </div>
                </div>

                @if (editingTaskId == task.Id && editDraft is not null)
                {
                    <div class="px-4 pb-4">
                        @Editor(editDraft, "Save", () => SaveEdit(task), CancelEdit)
                    </div>
                }
            </div>
        }
    </div>

    <!-- Finished tasks: hide or clear -->
    @if (DoneCount > 0)
    {
        <div class="flex items-center justify-end gap-1 mb-3 text-xs" style="color:rgb(var(--fg) / 0.4)">
            @if (confirmingClear)
            {
                <span class="mr-1">Delete @DoneCount done @(DoneCount == 1 ? "task" : "tasks")? Their pomodoros stay in Stats.</span>
                <button class="px-2 py-1 rounded-lg transition hover:bg-fg/5" @onclick="() => confirmingClear = false">Cancel</button>
                <button class="px-2 py-1 rounded-lg font-semibold text-danger transition hover:bg-red-500/10" @onclick="ClearDone">Delete</button>
            }
            else
            {
                <button class="px-2 py-1 rounded-lg transition hover:bg-fg/5" @onclick="ToggleHideDone">
                    @(hideDone ? $"Show done ({DoneCount})" : "Hide done")
                </button>
                <button class="px-2 py-1 rounded-lg transition hover:bg-fg/5" @onclick="() => confirmingClear = true">Clear done</button>
            }
        </div>
    }

    <!-- Add Task -->
    @if (addDraft is not null)
    {
        <div class="glass rounded-xl p-4 mt-2">
            @Editor(addDraft, "Add", AddTask, CancelAdd)
        </div>
    }
    else
    {
        <button class="w-full py-3 rounded-xl text-xs font-medium transition-all duration-150 hover:bg-fg/5"
                style="border:1.5px dashed rgb(var(--fg) / 0.12);color:rgb(var(--fg) / 0.3)"
                @onclick="StartAdd">
            + Add task
        </button>
    }
</div>

@code {
    [Parameter]
    public int? SelectedTaskId { get; set; }

    [Parameter]
    public EventCallback<(int? Id, string? Title)> OnTaskSelected { get; set; }

    private List<PomodoroTask> tasks = new();
    private string? userId;
    private bool _loaded;

    // The user's own calendar day, for "Today" / "Overdue"; UTC until the browser reports its offset
    private DateOnly today = DateOnly.FromDateTime(DateTime.UtcNow);
    private bool hideDone;
    private bool confirmingClear;

    private TaskDraft? addDraft;
    private int? editingTaskId;
    private TaskDraft? editDraft;

    private enum ListFilter { All, Today, Important }
    private ListFilter filter;

    private IEnumerable<PomodoroTask> VisibleTasks => tasks.Where(t => (!hideDone || !t.IsCompleted) && InFilter(t, filter));
    private int DoneCount => tasks.Count(t => t.IsCompleted);

    private bool InFilter(PomodoroTask task, ListFilter f) => f switch
    {
        ListFilter.Today => TaskDue.IsForToday(task, today),
        ListFilter.Important => task.Priority == TaskPriority.High,
        _ => true
    };

    /// <summary>
    /// What to work on after <paramref name="doneId"/>: the next open task in the list as shown,
    /// today's first, so finishing one moves the timer on.
    /// </summary>
    public PomodoroTask? NextTask(int doneId)
        => tasks.Where(t => t.Id != doneId && !t.IsCompleted && InFilter(t, filter))
                .OrderBy(t => TaskDue.IsForToday(t, today) ? 0 : 1)
                .ThenBy(t => t.SortOrder)
                .FirstOrDefault();

    // What the add and edit forms change; copied onto the task only on save
    private sealed class TaskDraft
    {
        public string Title { get; set; } = "";
        public int Estimated { get; set; } = 1;
        public TaskPriority Priority { get; set; } = TaskPriority.Normal;
        public DateOnly? DueDate { get; set; }
        public string? Notes { get; set; }
    }

    // Only set while prerendering (statically, before the circuit exists)
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Loaded during prerender and carried into the circuit: the first HTML already lists the
    // tasks, and the circuit starts from the same data instead of querying again
    [PersistentState]
    public List<PomodoroTask>? PrerenderedTasks { get; set; }

    [PersistentState]
    public int? UtcOffsetMinutes { get; set; }

    [PersistentState]
    public bool HideDone { get; set; }

    [PersistentState]
    public string? Filter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is null) return;

        if (HttpContext is not null)
        {
            UtcOffsetMinutes = ClientPreferences.UtcOffsetMinutes(HttpContext);
            HideDone = ClientPreferences.HideDoneTasks(HttpContext);
            Filter = ClientPreferences.TaskFilter(HttpContext);
        }
        PrerenderedTasks ??= await TaskService.GetTasksAsync(userId);

        tasks = PrerenderedTasks;
        hideDone = HideDone;
        filter = Filter switch { "today" => ListFilter.Today, "important" => ListFilter.Important, _ => ListFilter.All };
        if (UtcOffsetMinutes is int offset)
            today = DateOnly.FromDateTime(DateTime.UtcNow.AddMinutes(offset));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // No tz cookie yet (first visit): ask the browser once the circuit is up
        if (!firstRender || _loaded || UtcOffsetMinutes is not null) return;
        _loaded = true;

        try
        {
            var offsetMinutes = await JS.InvokeAsync<int>("pomodoroTime.utcOffsetMinutes");
            today = DateOnly.FromDateTime(DateTime.UtcNow.AddMinutes(offsetMinutes));
            StateHasChanged();
        }
        catch (JSException) { /* keep UTC */ }
    }

    public async Task RefreshTasks()
    {
        if (userId is not null)
        {
            tasks = await TaskService.GetTasksAsync(userId);
            StateHasChanged();
        }
    }

    private RenderFragment Editor(TaskDraft draft, string saveLabel, Func<Task> save, Action cancel) => @<div>
        <input @bind="draft.Title" @bind:event="oninput"
               placeholder="What are you working on?"
               maxlength="200"
               class="w-full focus:outline-none text-sm pb-2 mb-4"
               style="background:transparent;color:rgb(var(--fg));border-bottom:1px solid rgb(var(--fg) / 0.15)"
               @onkeydown="e => HandleEditorKeyDown(e, save, cancel)" />

        <div class="flex flex-wrap items-center gap-x-5 gap-y-3 mb-3">
            <div class="flex items-center gap-2">
                <span class="text-xs" style="color:rgb(var(--fg) / 0.4)">Pomodoros</span>
                <button class="w-6 h-6 rounded-md flex items-center justify-center transition hover:bg-fg/10 text-sm"
                        style="background:rgb(var(--fg) / 0.06);color:rgb(var(--fg) / 0.6)"
                        @onclick="() => draft.Estimated = Math.Max(1, draft.Estimated - 1)">−</button>
                <span class="w-5 text-center text-sm" style="color:rgb(var(--fg))">@draft.Estimated</span>
                <button class="w-6 h-6 rounded-md flex items-center justify-center transition hover:bg-fg/10 text-sm"
                        style="background:rgb(var(--fg) / 0.06);color:rgb(var(--fg) / 0.6)"
                        @onclick="() => draft.Estimated = Math.Min(99, draft.Estimated + 1)">+</button>
            </div>

            <div class="flex items-center gap-1" role="group" aria-label="Priority">
                @foreach (var p in Enum.GetValues<TaskPriority>())
                {
                    var on = draft.Priority == p;
                    <button class="px-2 py-1 rounded-md text-xs transition hover:bg-fg/10"
                            style="@(on ? "background:rgb(var(--fg) / 0.14);color:rgb(var(--fg))" : "color:rgb(var(--fg) / 0.4)")"
                            aria-pressed="@(on ? "true" : "false")"
                            @onclick="() => draft.Priority = p">@p</button>
                }
            </div>

            <div class="flex items-center gap-2">
                <span class="text-xs" style="color:rgb(var(--fg) / 0.4)">Due</span>
                <input type="date" @bind="draft.DueDate"
                       class="text-xs rounded-md px-2 py-1 bg-field focus:outline-none"
                       style="color:rgb(var(--fg));border:1px solid rgb(var(--fg) / 0.12)" />
                @if (draft.DueDate is not null)
                {
                    <button class="text-xs transition hover:opacity-80" style="color:rgb(var(--fg) / 0.4)"
                            title="Remove the due date"
                            @onclick="() => draft.DueDate = null">✕</button>
                }
            </div>
        </div>

        <textarea @bind="draft.Notes" @bind:event="oninput"
                  placeholder="Notes (optional)"
                  rows="2"
                  maxlength="@PomodoroTask.MaxNotesLength"
                  class="w-full text-xs rounded-md px-2 py-1.5 mb-3 bg-field focus:outline-none resize-y"
                  style="color:rgb(var(--fg));border:1px solid rgb(var(--fg) / 0.12)"></textarea>

        <div class="flex justify-end gap-2">
            <button class="px-3 py-1.5 text-xs rounded-lg transition hover:bg-fg/5"
                    style="color:rgb(var(--fg) / 0.4)"
                    @onclick="cancel">Cancel</button>
            <button class="px-4 py-1.5 text-xs rounded-lg font-semibold transition hover:opacity-90"
                    style="background:rgb(var(--fg) / 0.12);color:rgb(var(--fg))"
                    @onclick="save">@saveLabel</button>
        </div>
    </div>;

    private static async Task HandleEditorKeyDown(KeyboardEventArgs e, Func<Task> save, Action cancel)
    {
        if (e.Key == "Enter") await save();
        if (e.Key == "Escape") cancel();
    }

    private (string Text, bool Overdue)? DueLabel(PomodoroTask task) => TaskDue.Label(task, today);

    private async Task SelectTask(PomodoroTask task)
    {
        var newId = task.Id == SelectedTaskId ? (int?)null : task.Id;
        var newTitle = newId.HasValue ? task.Title : null;
        await OnTaskSelected.InvokeAsync((newId, newTitle));
    }

    private void StartAdd()
    {
        // A task added while a list is shown belongs in it
        addDraft = new TaskDraft
        {
            DueDate = filter == ListFilter.Today ? today : null,
            Priority = filter == ListFilter.Important ? TaskPriority.High : TaskPriority.Normal
        };
        CancelEdit();
    }

    private async Task AddTask()
    {
        if (addDraft is null || string.IsNullOrWhiteSpace(addDraft.Title) || userId is null) return;

        await TaskService.AddTaskAsync(userId, addDraft.Title.Trim(), addDraft.Estimated,
            addDraft.Priority, addDraft.DueDate, addDraft.Notes);
        tasks = await TaskService.GetTasksAsync(userId);
        addDraft = null;
    }

    private void CancelAdd() => addDraft = null;

    private void StartEdit(PomodoroTask task)
    {
        if (editingTaskId == task.Id)
        {
            CancelEdit();
            return;
        }
        editingTaskId = task.Id;
        editDraft = new TaskDraft
        {
            Title = task.Title,
            Estimated = task.EstimatedPomodoros,
            Priority = task.Priority,
            DueDate = task.DueDate,
            Notes = task.Notes
        };
        addDraft = null;
    }

    private void CancelEdit()
    {
        editingTaskId = null;
        editDraft = null;
    }

    private async Task SaveEdit(PomodoroTask task)
    {
        if (editDraft is null || string.IsNullOrWhiteSpace(editDraft.Title)) return;

        task.Title = editDraft.Title.Trim();
        task.EstimatedPomodoros = editDraft.Estimated;
        task.Priority = editDraft.Priority;
        task.DueDate = editDraft.DueDate;
        task.Notes = string.IsNullOrWhiteSpace(editDraft.Notes) ? null : editDraft.Notes.Trim();
        await TaskService.UpdateTaskAsync(task);
        CancelEdit();

        // The timer shows the selected task's title
        if (task.Id == SelectedTaskId)
            await OnTaskSelected.InvokeAsync((task.Id, task.Title));
    }

    private async Task ToggleComplete(PomodoroTask task)
    {
        task.IsCompleted = !task.IsCompleted;
        await TaskService.UpdateTaskAsync(task);

        // Finishing the task the timer is on moves the timer to the next one
        if (task.IsCompleted && task.Id == SelectedTaskId)
        {
            var next = NextTask(task.Id);
            await OnTaskSelected.InvokeAsync((next?.Id, next?.Title));
        }
    }

    private async Task SetFilter(ListFilter f)
    {
        filter = f;
        var value = f switch { ListFilter.Today => "today", ListFilter.Important => "important", _ => "" };
        try { await JS.InvokeVoidAsync("pomodoroPrefs.set", ClientPreferences.TaskFilterCookie, value); }
        catch (JSException) { /* only lasts this page */ }
    }

    private async Task DeleteTask(PomodoroTask task)
    {
        if (userId is null) return;
        await TaskService.DeleteTaskAsync(task.Id, userId);
        tasks = await TaskService.GetTasksAsync(userId);
        if (editingTaskId == task.Id) CancelEdit();

        if (SelectedTaskId == task.Id)
            await OnTaskSelected.InvokeAsync((null, null));
    }

    private async Task ToggleHideDone()
    {
        hideDone = !hideDone;
        try { await JS.InvokeVoidAsync("pomodoroPrefs.set", ClientPreferences.HideDoneTasksCookie, hideDone ? "1" : "0"); }
        catch (JSException) { /* only lasts this page */ }
    }

    private async Task ClearDone()
    {
        confirmingClear = false;
        if (userId is null) return;

        var selectedWasDone = tasks.Any(t => t.Id == SelectedTaskId && t.IsCompleted);
        await TaskService.DeleteCompletedTasksAsync(userId);
        tasks = await TaskService.GetTasksAsync(userId);
        if (editingTaskId is int id && tasks.All(t => t.Id != id)) CancelEdit();

        if (selectedWasDone)
            await OnTaskSelected.InvokeAsync((null, null));
    }

    // Swaps with the neighbour the user sees, so hidden done tasks don't swallow a click
    private async Task Move(PomodoroTask task, int direction)
    {
        if (userId is null) return;
        var visible = VisibleTasks.ToList();
        var idx = visible.IndexOf(task);
        var other = idx + direction;
        if (idx < 0 || other < 0 || other >= visible.Count) return;

        var ids = tasks.Select(t => t.Id).ToList();
        var a = ids.IndexOf(task.Id);
        var b = ids.IndexOf(visible[other].Id);
        (ids[a], ids[b]) = (ids[b], ids[a]);
        await TaskService.ReorderTasksAsync(userId, ids);
        tasks = await TaskService.GetTasksAsync(userId);
    }
}
