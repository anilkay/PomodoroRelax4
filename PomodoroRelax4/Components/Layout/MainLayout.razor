@inherits LayoutComponentBase

<div class="app-bg" style="@BackgroundStyle">

    <!-- Nav -->
    <header class="sticky top-0 z-20" style="background: rgb(var(--header) / 0.7); backdrop-filter: blur(16px); border-bottom: 1px solid rgb(var(--fg) / 0.06);">
        <div class="max-w-2xl mx-auto px-5 py-3 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2 text-fg font-semibold tracking-tight no-underline hover:opacity-80 transition" style="text-decoration:none">
                <span style="color: @AccentColor; font-size:1.1rem">&#9679;</span>
                <span>PomodoroRelax</span>
            </a>
            <div class="flex items-center gap-1">
            <AuthorizeView>
                <Authorized>
                    <div class="flex items-center gap-1">
                        <a href="/stats"
                           class="text-fg hover:text-fg text-xs font-medium px-3 py-1.5 rounded-lg transition hover:bg-fg/5" style="opacity:0.5; text-decoration:none">
                            Stats
                        </a>
                        <a href="/settings"
                           class="text-fg hover:text-fg text-xs font-medium px-3 py-1.5 rounded-lg transition hover:bg-fg/5" style="opacity:0.5; text-decoration:none">
                            Settings
                        </a>
                        <AuthorizeView Roles="Admin" Context="adminContext">
                            <a href="/Admin/Users"
                               class="text-fg hover:text-fg text-xs font-medium px-3 py-1.5 rounded-lg transition hover:bg-fg/5" style="opacity:0.5; text-decoration:none">
                                Users
                            </a>
                        </AuthorizeView>
                        <div class="w-px h-4 mx-1" style="background:rgb(var(--fg) / 0.1)"></div>
                        <form method="post" action="/Account/Logout" class="m-0">
                            <AntiforgeryToken />
                            <button type="submit"
                                    class="text-fg text-xs px-3 py-1.5 rounded-lg transition hover:bg-fg/5" style="opacity:0.3">
                                Sign out
                            </button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
            @* Plain button handled by js/site.js; the layout isn't interactive *@
            <button type="button" data-theme-toggle
                    class="theme-toggle text-fg text-sm w-8 h-8 rounded-lg transition hover:bg-fg/5" style="opacity:0.5"
                    title="Switch light / dark" aria-label="Switch between light and dark mode">
                <span class="icon-to-light">☀</span><span class="icon-to-dark">☾</span>
            </button>
            </div>
        </div>
    </header>

    <main class="max-w-2xl mx-auto px-5 py-8">
        @Body
    </main>
</div>

@code {
    [CascadingParameter]
    private TimerMode? CurrentMode { get; set; }

    private string AccentColor => CurrentMode switch
    {
        TimerMode.ShortBreak => "#34d399",
        TimerMode.LongBreak  => "#818cf8",
        _                    => "#f87171"
    };

    private string BackgroundStyle => CurrentMode switch
    {
        TimerMode.ShortBreak => "background: radial-gradient(ellipse at 50% -20%, rgba(52,211,153,0.14) 0%, rgb(var(--bg)) 65%);",
        TimerMode.LongBreak  => "background: radial-gradient(ellipse at 50% -20%, rgba(129,140,248,0.14) 0%, rgb(var(--bg)) 65%);",
        _                    => "background: radial-gradient(ellipse at 50% -20%, rgba(248,113,113,0.14) 0%, rgb(var(--bg)) 65%);"
    };
}
