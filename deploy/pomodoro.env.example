# Copy to pomodoro.env (Quadlet: %E/pomodoro/pomodoro.env) and restrict it:
#   chmod 600 pomodoro.env
# Use the same password in MSSQL_SA_PASSWORD and the connection string.

# SQL Server container (the password is read only when the data volume is first
# initialised). It must be at least 8 characters and use three of: upper case,
# lower case, digits, symbols. Avoid ";" since it ends a connection string value.
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=CHANGE_ME
# Express is free for production use (10 GB per database). Developer is not
# licensed for production.
MSSQL_PID=Express

# App. "pomodoro-db" is the database container's name on the shared network.
# The app creates the PomodoroRelax4 database and applies migrations on startup.
ConnectionStrings__DefaultConnection=Server=pomodoro-db,1433;Database=PomodoroRelax4;User Id=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# The app listens on plain HTTP behind a TLS-terminating proxy (Cloudflare
# Tunnel, Caddy, nginx, ...). This makes it honour X-Forwarded-Proto/For so the
# sign-in cookie gets the Secure flag and the register rate limit sees the real
# client IP. Keep it on, and keep the published port bound to 127.0.0.1.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Log level (Trace, Debug, Information, Warning, Error).
#Logging__LogLevel__Default=Information
