@page
@model PomodoroRelax4.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="flex justify-center">
    <div class="bg-surface border border-fg/5 backdrop-blur rounded-lg p-8 w-full max-w-sm">
        <h2 class="text-2xl font-bold text-fg text-center mb-6">@(Model.RegistrationOpen ? "Create Admin Account" : "Registration Closed")</h2>

        @if (Model.ErrorMessage is not null)
        {
            <div class="bg-red-700/40 text-fg text-sm rounded p-3 mb-4">@Model.ErrorMessage</div>
        }

        @if (!Model.RegistrationOpen)
        {
            <p class="text-fg/80 text-sm text-center">Accounts are created by the administrator. Ask them for one.</p>
        }
        else
        {
        <p class="text-fg/70 text-sm mb-4">Use the administrator e-mail set in the server configuration.</p>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="block text-fg/80 text-sm mb-1">Username</label>
                <input asp-for="Input.UserName"
                       class="w-full px-3 py-2 rounded bg-field border border-fg/10 text-fg placeholder-fg/50 focus:outline-none focus:ring-2 focus:ring-fg/40"
                       placeholder="myusername" autocomplete="username" />
                <span asp-validation-for="Input.UserName" class="text-danger text-xs mt-1 block"></span>
            </div>

            <div class="mb-4">
                <label class="block text-fg/80 text-sm mb-1">Email</label>
                <input asp-for="Input.Email" type="email"
                       class="w-full px-3 py-2 rounded bg-field border border-fg/10 text-fg placeholder-fg/50 focus:outline-none focus:ring-2 focus:ring-fg/40"
                       placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger text-xs mt-1 block"></span>
            </div>

            <div class="mb-4">
                <label class="block text-fg/80 text-sm mb-1">Password</label>
                <input asp-for="Input.Password" type="password"
                       class="w-full px-3 py-2 rounded bg-field border border-fg/10 text-fg placeholder-fg/50 focus:outline-none focus:ring-2 focus:ring-fg/40"
                       placeholder="At least @PasswordRules.MinLength characters" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger text-xs mt-1 block"></span>
            </div>

            <div class="mb-6">
                <label class="block text-fg/80 text-sm mb-1">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" type="password"
                       class="w-full px-3 py-2 rounded bg-field border border-fg/10 text-fg placeholder-fg/50 focus:outline-none focus:ring-2 focus:ring-fg/40"
                       placeholder="Repeat password" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger text-xs mt-1 block"></span>
            </div>

            <button type="submit"
                    class="w-full bg-fg/20 hover:bg-fg/30 text-fg font-semibold py-2 rounded transition">
                Register
            </button>
        </form>
        }

        <p class="text-fg/60 text-sm text-center mt-4">
            Already have an account? <a href="/Account/Login" class="text-fg underline">Login</a>
        </p>
    </div>
</div>
