<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — PomodoroRelax</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen" style="background-color:#df5454;">
    <header class="max-w-xl mx-auto pt-4 px-4">
        <nav class="flex items-center justify-between border-b border-white/20 pb-3 mb-6">
            <h1 class="text-xl font-bold text-white tracking-wide">🍅 PomodoroRelax</h1>
        </nav>
    </header>
    <main class="max-w-xl mx-auto px-4">
        @RenderBody()
    </main>
</body>
</html>
